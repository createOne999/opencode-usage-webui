{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./web/*"] },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["build.ts", "index.ts", "server.ts", "web/**/*.ts", "web/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
