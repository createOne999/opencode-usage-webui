{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["plugin/index.ts", "plugin/src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["reference", "node_modules"]
}
